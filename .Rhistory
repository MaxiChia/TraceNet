#| label: activity-heatmap
#| code-fold: true
#| code-summary: "Show code"
#| fig-width: 10
#| fig-height: 4
#| fig-cap: "Figure 4.1: System activity heatmap by weekday and hour (UTC)"
#| eval: true
mc2_df |>
count(wday, hour) |>
ggplot(aes(x = hour, y = wday, fill = n)) +
geom_tile(colour = "white", linewidth = 0.3) +
scale_fill_gradient(
low  = "#f7fbff",
high = "#08519c",
name = "Event count"
) +
scale_x_continuous(
breaks = seq(0, 23, by = 2),
labels = paste0(seq(0, 23, by = 2), ":00")
) +
labs(
title    = "When Is the System Most Active?",
subtitle = "Heatmap of event counts by weekday and hour (UTC)",
x        = "Hour of Day (UTC)",
y        = NULL
) +
theme_minimal(base_size = 12) +
theme(
panel.grid  = element_blank(),
axis.text.x = element_text(angle = 45, hjust = 1),
plot.title  = element_text(face = "bold")
)
#| label: packages
#| code-fold: true
#| code-summary: "Show code"
#| warning: false
pacman::p_load(tidyverse, jsonlite, lubridate, here, scales, ggtext, patchwork, plotly, visNetwork, tidygraph, ggraph, igraph, DT, knitr, ggrepel)
#| code-fold: true
mc2_df <- readRDS("data/raw/mc2_df.rds")
org_chart <- fromJSON("data/raw/org_chart.json")
cat("mc2_df rows:", nrow(mc2_df), "\n")
cat("mc2_df cols:", ncol(mc2_df), "\n")
cat("Date range:",
format(as_datetime(min(mc2_df$when)), "%Y-%m-%d"), "to",
format(as_datetime(max(mc2_df$when)), "%Y-%m-%d"), "\n")
#| code-fold: true
#| code-summary: "Show code"
#| include: false
mc2_df <- mc2_df |>
mutate(
datetime = as_datetime(when),
date     = as_date(datetime),
hour     = hour(datetime),
wday     = wday(datetime, label = TRUE, abbr = TRUE)
)
details_flat <- mc2_df$details
mc2_df       <- mc2_df |> bind_cols(details_flat)
#| label: event-frequency
#| code-fold: true
#| code-summary: "Show code"
event_counts <- mc2_df |>
count(short_name, sort = TRUE) |>
rename(`Event Type` = short_name,
Count = n) |>
mutate(`% of Total` = percent(Count / sum(Count),
accuracy = 0.1))
DT::datatable(
event_counts,
options  = list(pageLength = 24,
dom        = "t",
order      = list(list(1, "desc"))),
rownames = FALSE,
caption  = "Table 4.1: Event type frequencies (n = 185,147)"
)
#| label: activity-heatmap
#| code-fold: true
#| code-summary: "Show code"
#| fig-width: 10
#| fig-height: 4
#| fig-cap: "Figure 4.1: System activity heatmap by weekday and hour (UTC)"
#| eval: true
mc2_df |>
count(wday, hour) |>
ggplot(aes(x = hour, y = wday, fill = n)) +
geom_tile(colour = "white", linewidth = 0.3) +
scale_fill_gradient(
low  = "#f7fbff",
high = "#08519c",
name = "Event count"
) +
scale_x_continuous(
breaks = seq(0, 23, by = 2),
labels = paste0(seq(0, 23, by = 2), ":00")
) +
labs(
title    = "When Is the System Most Active?",
subtitle = "Heatmap of event counts by weekday and hour (UTC)",
x        = "Hour of Day (UTC)",
y        = NULL
) +
theme_minimal(base_size = 12) +
theme(
panel.grid  = element_blank(),
axis.text.x = element_text(angle = 45, hjust = 1),
plot.title  = element_text(face = "bold")
)
